# Template for .env - copy it and fill in real values:
#
#   cp .env.example .env
#
# .env is gitignored and must never be committed. This repository is public.
#
# Add each new variable here (with a safe placeholder or an empty value) as the
# project starts needing it, so this template stays a complete inventory of what
# a developer must set locally.

# Prisma datasource. Read by prisma.config.ts, which loads this file via dotenv.
# The default is a local SQLite file, itself gitignored.
DATABASE_URL="file:./dev.db"
