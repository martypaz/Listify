# Template for .env - copy it and fill in real values:
#
#   cp .env.example .env
#
# .env is gitignored and must never be committed. This repository is public.
#
# Listify has no application code yet, so there are no real variables to list.
# Add each one here (with a safe placeholder or an empty value) as the project
# starts needing it, so the template stays a complete inventory of what a
# developer must set locally.

# EXAMPLE_API_KEY=
# EXAMPLE_DATABASE_URL=
