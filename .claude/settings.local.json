{
  "permissions": {
    "allow": [
      "Bash(claude --version)",
      "Bash(gh auth *)",
      "Bash(gh repo *)",
      "Bash(gh api *)",
      "PowerShell($g = Get-Command gh -ErrorAction SilentlyContinue; if \\($null -eq $g\\) { \"gh: NOT INSTALLED\" } else { \"gh at: \" + $g.Source; gh --version })",
      "mcp__claude_ai_Linear__list_teams",
      "WebFetch(domain:github.com)",
      "PowerShell(try { $r = Invoke-RestMethod -Uri \"https://api.github.com/repos/finna/Finn-loop\" -Headers @{ \"User-Agent\" = \"claude-code\" } -ErrorAction Stop; \"default_branch: \" + $r.default_branch; \"full_name: \" + $r.full_name } catch { \"API ERROR: \" + $_.Exception.Message })",
      "mcp__claude_ai_Linear__get_team",
      "mcp__claude_ai_Linear__list_issues",
      "PowerShell(winget install *)",
      "mcp__claude_ai_Linear__list_issue_labels",
      "mcp__claude_ai_Linear__list_issue_statuses",
      "mcp__claude_ai_Linear__create_issue_label"
    ]
  }
}
