# Claude Code local, per-machine state
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Regenerated by `next dev` on every run (see
# node_modules/next/dist/server/lib/generate-agent-files.js). Ignored rather
# than committed so they cannot dirty the tree and fail finn-build preflight.
AGENTS.md
CLAUDE.md

# Local secrets - never commit. Only .env.example is tracked.
# Deliberately narrower than create-next-app's `.env*`, which would also
# ignore .env.example and hide the template from the repo.
.env
.env.*
!.env.example

# Local SQLite database
*.db
*.db-journal
prisma/dev.db*

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma
